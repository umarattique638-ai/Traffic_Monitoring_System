PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/traffic
JWT_SECRET=yahan-kam-az-kam-32-characters-ki-lambi-random-secret
SUPER_ADMIN_EMAILS=admin@example.com

ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7
SESSION_MAX_DAYS=30

# EMAIL (SMTP) - SMTP_HOST khali ho to email terminal mein print hogi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Traffic Monitoring <no-reply@example.com>

# ---------------------------------------------------------
# TRAFFIC MONITORING (TailWatch)
# ---------------------------------------------------------
# Collector Worker ka address (wrangler deploy ke baad milta hai)
COLLECTOR_URL=https://tailwatch-collector.<your-account>.workers.dev
REGION=in
# Nayi sites ki id is number se upar shuru hogi
SITE_ID_FLOOR=10000
RETENTION_DAYS=395
# Pipeline ruk jaye to alert is email par
OWNER_EMAIL=you@example.com
# Lamba random string: Vercel crons isi ke saath /api/v1/internal/* bulate hain
CRON_SECRET=change-me

# KV_MODE=cloudflare (production) | local (wrangler dev ka local KV)
KV_MODE=cloudflare
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
# Token: Account > Workers KV Storage > Edit
CF_API_TOKEN=
# Sirf KV_MODE=local ke liye: workers folder ka path
# KV_LOCAL_WORKERS_DIR=../workers

# ClickHouse (clickhouse/003_read_user.sql aur 004_prune_user.sql se bane users)
CLICKHOUSE_URL=https://<host>.clickhouse.cloud:8443
CLICKHOUSE_DATABASE=tailwatch
CLICKHOUSE_READ_USER=tw_read
CLICKHOUSE_READ_PASSWORD=
CLICKHOUSE_PRUNE_USER=tw_prune
CLICKHOUSE_PRUNE_PASSWORD=

# Sirf development: domain ka DNS check chhor do / private address (localhost, .test) verify karne do
# TAILWATCH_SKIP_DOMAIN_CHECK=true
# VERIFIER_ALLOW_PRIVATE=true
